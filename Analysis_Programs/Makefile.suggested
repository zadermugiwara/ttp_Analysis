# Makefile.suggested — lean build, no copying binaries around
# Usage:
#   make -f Makefile.suggested        # builds ttp_Analysis
#   ANALYZER=/custom/path/ttp_Analysis make -f Makefile.suggested
#
CXX         ?= g++
ROOTCFLAGS  := $(shell $(ROOTSYS)/bin/root-config --cflags)
ROOTGLIBS   := $(shell $(ROOTSYS)/bin/root-config --glibs)

# Optional: point to your external libs with env vars (or edit here)
HEPMC_DIR   ?= /home/higinio/Documentos/ASE/HERWIG
FASTJET_DIR ?= /home/higinio/Documentos/ASE/HERWIG

HepMClib    := -L$(HEPMC_DIR)/install/lib -lHepMC
FastJetlib  := -L$(FASTJET_DIR)/lib -lfastjet -lfastjettools -lValenciaPlugin

CXXFLAGS    += -O3 -march=native -pipe -fPIC $(ROOTCFLAGS)
LDFLAGS     += $(ROOTGLIBS) $(HepMClib) $(FastJetlib)

all: ttp_Analysis

ttp_Analysis.o: ttp_Analysis.cc
	@echo \"Compiling $<\"
	$(CXX) $(CXXFLAGS) -c -Wno-deprecated $< -o $@

ttp_Analysis: ttp_Analysis.o
	@echo \"Linking $@\"
	$(CXX) $^ $(LDFLAGS) -o $@

clean:
	rm -f ttp_Analysis *.o
