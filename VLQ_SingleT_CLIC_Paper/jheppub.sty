\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{jheppub}[2024/05/28 Simplified JHEP-inspired layout]

\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage{titlesec}

\geometry{a4paper,margin=1in}

\setlength{\parindent}{15pt}
\setlength{\parskip}{0.5em}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\thepage}

\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape}{\thesubsubsection}{1em}{}

\makeatletter

\def\JHEP@authlist{}
\def\JHEP@affillist{}
\def\JHEP@abstract{}
\def\JHEP@keywords{}
\newcount\JHEP@anoncount
\JHEP@anoncount=\z@

\newcommand{\JHEP@void}{}

\newcommand{\JHEP@ifempty}[3]{%
  \edef\JHEP@tmp{#1}%
  \ifx\JHEP@tmp\@empty
    #2%
  \else
    #3%
  \fi
}

\newcommand{\JHEP@addtoauth}[1]{%
  \ifx\JHEP@authlist\@empty
    \gdef\JHEP@authlist{#1}%
  \else
    \g@addto@macro\JHEP@authlist{\\[0.5em]#1}%
  \fi
}

\newcommand{\JHEP@registeraffil}[2]{%
  \expandafter\gdef\csname JHEP@affil@#1\endcsname{#2}%
  \edef\JHEP@tmp{#1}%
  \ifcsdef{JHEP@affilcheck@#1}{}{%
    \expandafter\gdef\csname JHEP@affilcheck@#1\endcsname{1}%
    \ifx\JHEP@affillist\@empty
      \gdef\JHEP@affillist{#1}%
    \else
      \g@addto@macro\JHEP@affillist{,#1}%
    \fi
  }%
}

\renewcommand{\author}[2][]{%
  \def\JHEP@keys{#1}%
  \edef\JHEP@formatted{#2}%
  \JHEP@ifempty{#1}{}{%
    \edef\JHEP@formatted{#2$^{#1}$}%
  }%
  \JHEP@addtoauth{\JHEP@formatted}%
  \JHEP@ifempty{\@author}{%
    \gdef\@author{#2}%
  }{%
    \g@addto@macro\@author{, #2}%
  }%
}

\newcommand{\affiliation}[2][]{%
  \JHEP@ifempty{#1}{%
    \PackageWarning{jheppub}{Affiliation key missing; using numeric tag}%
    \advance\JHEP@anoncount by \@ne
    \edef\JHEP@tempkey{\the\JHEP@anoncount}%
    \JHEP@registeraffil{\JHEP@tempkey}{#2}%
  }{%
    \JHEP@registeraffil{#1}{#2}%
  }%
}

\renewcommand{\abstract}[1]{%
  \gdef\JHEP@abstract{#1}%
}

\newcommand{\keywords}[1]{%
  \gdef\JHEP@keywords{#1}%
}

\newcommand{\emailAdd}[1]{%
  \footnote{#1}%
}

\renewcommand{\maketitle}{%
  \begingroup
    \renewcommand\thefootnote{\fnsymbol{footnote}}%
    \thispagestyle{empty}%
    \begin{center}
      {\LARGE\bfseries \@title\par}%
      \vspace{1.3cm}
      {\large \JHEP@authlist\par}%
      \vspace{0.8cm}
      {\small
        \@for\JHEP@item:=\JHEP@affillist\do{%
          \JHEP@ifempty{\JHEP@item}{}{%
            $^{\JHEP@item}$~\csname JHEP@affil@\JHEP@item\endcsname\par
          }%
        }%
      }%
      \vspace{0.8cm}
      \textbf{Abstract}\par
      \vspace{0.3cm}
      \begin{minipage}{0.9\textwidth}
        \small \JHEP@abstract
      \end{minipage}%
      \JHEP@ifempty{\JHEP@keywords}{}{%
        \vspace{0.6cm}
        \textbf{Keywords:} \JHEP@keywords
      }%
    \end{center}
    \vspace{1cm}
    \setcounter{footnote}{0}%
    \renewcommand\thefootnote{\arabic{footnote}}%
  \endgroup
}

\makeatother
